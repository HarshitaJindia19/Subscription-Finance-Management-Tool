+@Test
+public void showBudgetAlertsTest() {
+    //Clear any existing subs
+    Data.subscriptions.clear();
+    Data.categoryBudgets.clear();
+
+    //Set the category budget - user inputs this
+    Data.categoryBudgets.put("Entertainment", 30.00);
+
+
+    ArrayList<String> sub1 = new ArrayList<>();
+    sub1.add("Netflix");
+    sub1.add("14.98");
+    sub1.add("Entertainment");
+    sub1.add("Monthly");
+    sub1.add("Mar 2");
+    sub1.add(null);
+    sub1.add("ACTIVE");
+
+    ArrayList<String> sub2 = new ArrayList<>();
+    sub2.add("HBO Max");
+    sub2.add("19.99");
+    sub2.add("Entertainment");
+    sub2.add("Monthly");
+    sub2.add("Mar 3");
+    sub2.add(null);
+    sub2.add("ACTIVE");
+
+    //Add subs to Data
+    Data.subscriptions.add(sub1);
+    Data.subscriptions.add(sub2);
+
+    //Call budget alert ()
+    Data.showBudgetAlerts();
+
+    //Check if total spent > budget
+    double total = 0;
+
+    //Go through each subscription in the list
+    for (int i = 0; i < Data.subscriptions.size(); i++) {
+        ArrayList<String> sub = Data.subscriptions.get(i);
+
+        //Get the cost as string and convert into number
+        String costStr = sub.get(1);
+        double cost = Double.parseDouble(costStr);
+
+        //Add to the total
+        total += cost;
+    }
+
+// Check if total spending exceeds the budget for "Entertainment"
+    double budget = Data.categoryBudgets.get("Entertainment");
+    assertTrue(total > budget, "Total spent should exceed the budget for Entertainment");
+
+}
