<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="HighExpenseBillsController">

    <Label text="HIGH-EXPENSE BILLS" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Enter threshold amount: $"/>
        <TextField fx:id="thresholdField" promptText="e.g. 20.00"/>
        <Button text="Search" onAction="#searchHighExpense"/>
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: grey;"/>

    <TableView fx:id="resultsTable" visible="false">
        <columns>
            <TableColumn fx:id="nameCol" text="Name"/>
            <TableColumn fx:id="costCol" text="Cost"/>
            <TableColumn fx:id="categoryCol" text="Category"/>
            <TableColumn fx:id="renewalCol" text="Billing"/>
            <TableColumn fx:id="statusCol" text="Status"/>
        </columns>
    </TableView>

</VBox>